{
  "name": "api-testing-framework",
  "version": "1.1.0",
  "description": "API test automation framework built with Cypress and JavaScript",
  "scripts": {
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e --browser chrome",
    "mock:start": "node mock-server/src/server.js",
    "mock:dev": "node --watch mock-server/src/server.js",
    "test": "npm run cy:run"
  },
  "keywords": [
    "cypress",
    "javascript",
    "api-testing",
    "test-automation",
    "contract-testing",
    "ajv",
    "github-actions"
  ],
  "engines": {
    "node": "24.x"
  },
  "author": "Guido Piaggio",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress": "^16.3.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "cypress-plugin-api": "^2.12.3",
    "cypress-plugin-steps": "^1.2.1",
    "cypress-terminal-report": "^7.3.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "mocha": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "cypress@16.3.0": true,
    "@scarf/scarf": false
  }
}