{
  "name": "api-testing-framework",
  "version": "1.0.0",
  "description": "Professional API test automation framework built with Cypress and TypeScript",
  "scripts": {
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e --browser chrome",
    "mock:start": "tsx mock-server/src/server.ts",
    "mock:dev": "tsx watch mock-server/src/server.ts",
    "typecheck:cypress": "tsc --noEmit -p cypress/tsconfig.json",
    "typecheck:mock": "tsc --noEmit -p mock-server/tsconfig.json",
    "typecheck": "npm run typecheck:cypress && npm run typecheck:mock",
    "test": "npm run cy:run"
  },
  "keywords": [
    "cypress",
    "typescript",
    "api-testing",
    "test-automation",
    "contract-testing",
    "ajv",
    "github-actions"
  ],
  "engines": {
    "node": "24.x"
  },
  "author": "Guido Piaggio",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress": "^16.1.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "cypress-plugin-api": "^2.12.3",
    "cypress-plugin-steps": "^1.2.1",
    "cypress-terminal-report": "^7.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  }
}