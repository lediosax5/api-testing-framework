{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "commonjs",
    "strict": true,
    "noEmit": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "cypress",
      "node",
      "cypress-plugin-api",
      "cypress-plugin-steps",
      "cypress-terminal-report"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts"
  ]
}